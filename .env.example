# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
AGENT_FILE_SANDBOX_ROOT=.data/sandbox

# Default model selection
MODEL_PROVIDER=openrouter
MODEL_NAME=
MODEL_TEMPERATURE=0

# Model providers (leave unused providers blank)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Langfuse SDK v5 / OpenTelemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Reliability defaults
AGENT_MAX_STEPS=10
AGENT_MAX_SUBAGENT_DEPTH=3
AGENT_MODEL_TIMEOUT_MS=60000
AGENT_TOOL_TIMEOUT_MS=30000
AGENT_MAX_RETRIES=2
